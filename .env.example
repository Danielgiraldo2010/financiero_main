# Variables de Entorno

# URL del API backend (usado en vite.config.ts para el proxy)
# LOCAL: http://localhost:51953 (con SSL self-signed)
# PRODUCCION: reemplaza con tu URL real en .env.local
VITE_API_BACKEND=http://localhost:51953

# URL de la API para requests en cliente (usado en src/shared/config/env.ts)
# Si está vacío en producción, usará /api (proxy de Vercel)
VITE_API_URL=

# Nombre de la aplicación
VITE_APP_NAME=SistemaFinanciero UCaldas
